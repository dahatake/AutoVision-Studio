{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node", "electron"],
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tsconfig.main.tsbuildinfo"
  },
  "include": [
    "vite.main.config.ts",
    "vite.preload.config.ts",
    "vite.renderer.config.ts",
    "vitest.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
