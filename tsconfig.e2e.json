{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tsconfig.e2e.tsbuildinfo"
  },
  "include": [
    "playwright.config.ts",
    "tests/e2e/**/*.ts",
    "tests/fixtures/**/*.ts",
    "src/shared/**/*.ts"
  ],
  "exclude": ["src/shared/**/*.test.ts"]
}
